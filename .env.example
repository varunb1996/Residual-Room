# Copy to .env and fill in. .env is gitignored.

# Postgres with pgvector available (e.g. Neon). Plain postgres:// URLs are fine;
# the app switches them to the psycopg 3 driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# LLMs (free tiers; see config/models.yaml)
NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-...

# Email (Resend free plan). Mail only ever goes to addresses listed in TEST_EMAILS.
RESEND_API_KEY=re_...
EMAIL_FROM=Residual Room <onboarding@resend.dev>
TEST_EMAILS=you@example.com

# Telegram bot (from @BotFather) and the test channel it may post to.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_TEST_CHAT_ID=-100...

# Base URL for tracked links and unsubscribe links in sent messages.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: lifts GitHub's anonymous API limit for `make fetch`.
# GITHUB_TOKEN=
