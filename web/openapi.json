  "components": {
    "schemas": {
      "AuditOut": {
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "from_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From State"
          },
          "to_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To State"
          },
          "detail": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "at",
          "actor",
          "action",
          "from_state",
          "to_state",
          "detail"
        ],
        "title": "AuditOut"
      },
      "CampaignIn": {
        "properties": {
          "piece_id": {
            "type": "integer",
            "title": "Piece Id"
          },
          "segments": {
            "items": {
              "type": "string",
              "enum": [
                "transitioning",
                "practitioner"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Segments"
          },
          "channels": {
            "items": {
              "type": "string",
              "enum": [
                "email",
                "telegram",
                "whatsapp"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Channels"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          }
        },
        "type": "object",
        "required": [
          "piece_id",
          "segments",
          "channels"
        ],
        "title": "CampaignIn"
      },
      "CampaignOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "piece_id": {
            "type": "integer",
            "title": "Piece Id"
          },
          "piece_title": {
            "type": "string",
            "title": "Piece Title"
          },
          "segments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Segments"
          },
          "channels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Channels"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          },
          "deliveries": {
            "items": {
              "$ref": "#/components/schemas/DeliveryOut"
            },
            "type": "array",
            "title": "Deliveries"
          },
          "clicks": {
            "items": {
              "$ref": "#/components/schemas/ClickCount"
            },
            "type": "array",
            "title": "Clicks"
          }
        },
        "type": "object",
        "required": [
          "id",
          "piece_id",
          "piece_title",
          "segments",
          "channels",
          "scheduled_at",
          "status",
          "sent_at",
          "deliveries",
          "clicks"
        ],
        "title": "CampaignOut"
      },
      "CheckOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
